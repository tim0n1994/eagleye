[Unit]
Description=Prepare Eagleye's daily arXiv editorial draft
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/eagleye/arxiv-editorial-runtime/current
EnvironmentFile=%h/.config/eagleye/arxiv-editorial.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
UMask=0077
TimeoutStartSec=12min
ExecStart=%h/.local/bin/node scripts/arxiv-editorial.js daily --out %h/.local/share/eagleye/arxiv-editorial
