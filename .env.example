# Eagleye local development and deployment template.
# Copy to .env and keep the real file out of Git. Blank values are intentional.

# Application
NODE_ENV=
PORT=
EAGLEYE_HOST=
EAGLEYE_DB_PATH=
EAGLEYE_HEALTH_PORT=
SOURCE_TIMEOUT_MS=
FETCH_TIMEOUT_MS=

# MCP server and proxy
EAGLEYE_MCP_PORT=
