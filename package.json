{
  "name": "eagleye",
  "version": "1.1.2",
  "engines": {
    "node": "^22.21.0 || >=24.5.0"
  },
  "description": "Evidence-linked intelligence collection, enrichment, knowledge graph, and briefing pipeline.",
  "main": "server.js",
  "scripts": {
    "lint": "eslint . --ignore-pattern 'kg-worker/**' --ignore-pattern '_*.js'",
    "knip": "knip --exclude exports,nsExports,types,enumMembers",
    "test": "vitest run",
    "test:pipeline": "node --test server/services/__tests__/*.test.cjs mcp/__tests__/*.test.cjs && python3 -B -m unittest discover -s server/services/__tests__ -p 'test_*.py' -v",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky || true",
    "mcp": "node mcp/server.js",
    "mcp:proxy": "node mcp/chatgpt-proxy.js",
    "start": "node server.js 3019"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@resvg/resvg-js": "2.6.2",
    "@waffo/pancake-ts": "0.28.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "cheerio": "1.2.0",
    "dotenv": "^18.0.8",
    "fast-xml-parser": "^5.11.2",
    "ipaddr.js": "2.5.0",
    "jszip": "3.10.2",
    "juice": "12.2.4",
    "markdown-it": "15.0.3",
    "resend": "^6.17.2",
    "sanitize-html": "2.18.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "knip": "^6.42.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
